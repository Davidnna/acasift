# SQLite is convenient for the first local run:
DATABASE_URL=sqlite:///acasift-dev.db

# For PostgreSQL, use a URI such as:
# DATABASE_URL=postgresql+psycopg://acasift_user:change_this_password@localhost:5432/acasift_db

SECRET_KEY=replace-this-with-a-long-random-secret
MAX_CONTENT_LENGTH_MB=15
NGRAM_SIZE=5
MAX_COMPARISON_SOURCES=50
SESSION_COOKIE_SECURE=false

# SMTP settings required for public registration and account recovery.
# Example values below use STARTTLS; obtain credentials from your email provider.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=AcaSift <no-reply@example.com>
PUBLIC_APP_URL=https://acasift.onrender.com
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=1
