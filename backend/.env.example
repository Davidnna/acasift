# SQLite is convenient for the first local run:
DATABASE_URL=sqlite:///acasift-dev.db

# For PostgreSQL, use a URI such as:
# DATABASE_URL=postgresql+psycopg://acasift_user:change_this_password@localhost:5432/acasift_db

SECRET_KEY=replace-this-with-a-long-random-secret
# Optional: required only when creating the first platform administrator.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-setup-token
MAX_CONTENT_LENGTH_MB=15
NGRAM_SIZE=5
SESSION_COOKIE_SECURE=false

# Nylas Transactional Send (US region) for public registration and account recovery.
# Keep NYLAS_API_KEY secret; never commit a real key to Git.
NYLAS_API_KEY=replace-with-your-nylas-api-key
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_SENDING_DOMAIN=acasift.nylas.email
NYLAS_FROM_NAME=AcaSift
NYLAS_FROM_EMAIL_VERIFICATION=verify@acasift.nylas.email
NYLAS_FROM_EMAIL_PASSWORD_RESET=security@acasift.nylas.email
NYLAS_FROM_EMAIL_NOTIFICATION=notifications@acasift.nylas.email
# Optional: a real mailbox monitored by your team for replies.
# NYLAS_REPLY_TO=
NYLAS_API_TIMEOUT=20
PUBLIC_APP_URL=http://127.0.0.1:5173
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=1

# Optional scholarly discovery API credentials and polite-pool contact details.
# Public scholarly metadata search works without keys, subject to provider rate limits.
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# SCHOLARLY_SEARCH_CONTACT_EMAIL=

# AcaSift 0.16.0 live scholarly similarity search.
# Search providers: OpenAlex, Crossref, Europe PMC, DOAJ, Zenodo,
# Semantic Scholar and arXiv. Public metadata search works without API keys.
# SCHOLARLY_SEARCH_CONTACT_EMAIL=research-office@example.org
MAX_EXTERNAL_SOURCES=24
MAX_EXTERNAL_DOWNLOADS=8
MAX_EXTERNAL_DOWNLOAD_MB=12

# Semantic embeddings are optional. Install backend/requirements-semantic.txt
# and enable only on an instance with adequate memory/CPU.
ENABLE_LOCAL_SEMANTIC=false
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MATCH_THRESHOLD=0.82
