# Local database and application security.
DATABASE_URL=sqlite:///acasift-dev.db
SECRET_KEY=replace-this-with-a-long-random-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-setup-token
MAX_CONTENT_LENGTH_MB=15
NGRAM_SIZE=5
SESSION_COOKIE_SECURE=false

# Nylas transactional email (US region).
NYLAS_API_KEY=replace-with-your-nylas-api-key
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_SENDING_DOMAIN=acasift.nylas.email
NYLAS_FROM_NAME=AcaSift
NYLAS_FROM_EMAIL_VERIFICATION=verify@acasift.nylas.email
NYLAS_FROM_EMAIL_PASSWORD_RESET=security@acasift.nylas.email
NYLAS_FROM_EMAIL_NOTIFICATION=notifications@acasift.nylas.email
NYLAS_API_TIMEOUT=20
PUBLIC_APP_URL=http://127.0.0.1:5173
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=1

# Optional scholarly API credentials and contact information.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# A monitored contact email enables Unpaywall DOI lookups and polite-pool requests.
SCHOLARLY_SEARCH_CONTACT_EMAIL=

# Bounded external scholarly comparison settings.
MAX_EXTERNAL_SOURCES=40
MAX_EXTERNAL_DOWNLOADS=8
MAX_EXTERNAL_DOWNLOAD_MB=12
MAX_EXTERNAL_QUERIES=3
EXTERNAL_HTTP_TIMEOUT_SECONDS=8
EXTERNAL_DISCOVERY_MAX_WORKERS=12
EXTERNAL_RETRIEVAL_MAX_WORKERS=4
EXTERNAL_DISCOVERY_CACHE_TTL_SECONDS=300
MAX_UNPAYWALL_LOOKUPS_PER_RUN=20

# Optional local semantic matching. Keep disabled on low-memory instances.
ENABLE_LOCAL_SEMANTIC=false
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MATCH_THRESHOLD=0.82
